{
  "name": "artishare",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension that invites lists of email addresses to claude.ai artifacts in bulk.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "dev:fake": "wxt --mode fake",
    "build": "wxt build",
    "build:fake": "wxt build --mode fake",
    "zip": "wxt zip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "release": "npm run check && wxt zip",
    "release:store": "npm run check && ARTISHARE_STORE=true wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build:fake && playwright test",
    "postinstall": "wxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
